      "question_pool": [
        {
          "question": "Your perfect free day has one rule: you cannot spend it the way you normally would. What do you choose instead?",
          "answers": {
            "A": "Find somewhere peaceful, take my time, and enjoy having no schedule.",
            "B": "Go somewhere I have never been and see what I discover along the way.",
            "C": "Pick something I have always wondered about and finally figure out how it works.",
            "D": "Spend the day with people I enjoy and make it into something fun to remember.",
            "E": "Choose a quiet place where I can watch what is going on without needing to be in the middle of it.",
            "F": "Do something difficult and physical where I can really push myself.",
            "G": "Do as little as possible and enjoy not having to accomplish anything.",
            "H": "Use the day to finish something important that I never seem to have enough time for.",
            "I": "Choose something intense or competitive where I can really test myself.",
            "J": "Pack the day with activities and keep moving until I run out of time."
          }
        },
        {
          "question": "Which headline would you most want to describe your Saturday?",
          "answers": {
            "A": "Nothing Urgent Happened, and That Was Perfect",
            "B": "Local Person Wanders Somewhere New and Finds Something Unexpected",
            "C": "Mystery Finally Solved After Hours of Investigation",
            "D": "Friends Turn an Ordinary Day Into Something Memorable",
            "E": "Quiet Observer Notices What Everyone Else Missed",
            "F": "Challenge Accepted: Difficult Task Finished the Hard Way",
            "G": "Absolutely Nothing Accomplished; No Regrets",
